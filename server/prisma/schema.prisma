// ===================================================
// === ФІНАЛЬНА ВЕРСІЯ: schema.prisma (ВИПРАВЛЕНА) ===
// ===================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement()) // <-- ТУТ БУЛА ПОМИЛКА, ТЕПЕР ВИПРАВЛЕНО
  email     String   @unique
  password  String
  role      Role     @default(SOLDIER)
  soldier   Soldier?
}

enum Role {
  SOLDIER
  COMMANDER
  ADMIN
}

model Soldier {
  id          Int      @id @default(autoincrement())
  userId      Int?     @unique
  user        User?    @relation(fields: [userId], references: [id])
  name        String
  rank        String
  position    String
  phoneNumber String
  status      String   @default("ACTIVE")
  schedules   Schedule[]
  lastDutyTypeId   Int?

  company     String?  // Рота (напр. "1 Рота")
  platoon     String?  // Взвод (напр. "2 Взвод")
  squad       String?  // Відділення (напр. "1 Відділення")
  
  // ДОДАЄМО ЦІ ДВА РЯДКИ:
  swapRequestsSent     SwapRequest[] @relation("Requester")
  swapRequestsReceived SwapRequest[] @relation("TargetSoldier")
}

enum Status {
  ACTIVE
  LEAVE
  SICK
}

model DutyType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  schedules   Schedule[]
  personnelCount Int        @default(1) // <--- ДОДАЛИ ЦЕ ПОЛЕ (Скільки людей треба)
  
  allowedRanks String[] @default([]) 
}
model Schedule {
  id         Int      @id @default(autoincrement())
  date       DateTime
  soldierId  Int
  soldier    Soldier  @relation(fields: [soldierId], references: [id])
  dutyTypeId Int
  dutyType   DutyType @relation(fields: [dutyTypeId], references: [id])
  
  // ДОДАЄМО ЦЕЙ РЯДОК:
  swapRequests SwapRequest[]
}
// НОВА МОДЕЛЬ ДЛЯ ЗАПИТІВ НА ОБМІН
model SwapRequest {
  id               Int      @id @default(autoincrement())
  
  scheduleId       Int      // Який саме наряд хочемо віддати
  schedule         Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  requesterId      Int      // Хто просить мінятися (Ініціатор)
  requester        Soldier  @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  
  targetSoldierId  Int      // Кого просять вийти замість ініціатора
  targetSoldier    Soldier  @relation("TargetSoldier", fields: [targetSoldierId], references: [id], onDelete: Cascade)
  
  status           String   @default("PENDING") // Статуси: PENDING (Очікує), APPROVED (Схвалено), REJECTED (Відхилено)
  
  createdAt        DateTime @default(now())
}