generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  role         Role     @default(CADET)
  isFirstLogin Boolean  @default(true)
  soldier      Soldier?
}

enum Role {
  CADET
  SQUAD_COMMANDER
  GROUP_COMMANDER
  COURSE_SERGEANT
  COURSE_HEAD
  FACULTY_HEAD
  ADMIN
}

model Soldier {
  id             Int       @id @default(autoincrement())
  userId         Int?      @unique
  user           User?     @relation(fields: [userId], references: [id])
  name           String
  rank           String
  position       String
  phoneNumber    String
  birthDate      DateTime?
  status         String    @default("ACTIVE")
  company        String?
  platoon        String?
  squad          String?
  lastDutyTypeId Int?
  lastDutyType   DutyType? @relation("SoldierLastDuty", fields: [lastDutyTypeId], references: [id], onDelete: SetNull)

  schedules            Schedule[]
  swapRequestsSent     SwapRequest[] @relation("Requester")
  swapRequestsReceived SwapRequest[] @relation("TargetSoldier")
}

model DutyType {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  description    String?
  personnelCount Int      @default(1)
  allowedRanks   String[] @default([])

  schedules            Schedule[]
  soldiersWithLastDuty Soldier[] @relation("SoldierLastDuty")
}

model Schedule {
  id         Int      @id @default(autoincrement())
  date       DateTime
  soldierId  Int
  soldier    Soldier  @relation(fields: [soldierId], references: [id])
  dutyTypeId Int
  dutyType   DutyType @relation(fields: [dutyTypeId], references: [id])

  swapRequests SwapRequest[]
}

model SwapRequest {
  id              Int      @id @default(autoincrement())
  scheduleId      Int
  schedule        Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  requesterId     Int
  requester       Soldier  @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetSoldierId Int
  targetSoldier   Soldier  @relation("TargetSoldier", fields: [targetSoldierId], references: [id], onDelete: Cascade)
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}